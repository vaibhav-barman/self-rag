# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
# Optional: override the Groq model (default: openai/gpt-oss-20b)
GROQ_MODEL=
# Optional: model a call falls back to if the primary model's call fails (default: openai/gpt-oss-120b)
GROQ_FALLBACK_MODEL=
# Optional: enables a web-search fallback when documents cannot answer
TAVILY_API_KEY=
